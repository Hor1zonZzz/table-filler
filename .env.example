# DeepSeek API (主模型 - 用于对话编排)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DashScope API (视觉语言模型 - 用于文档理解)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-max

# 存储配置 (可选)
# DOC_STORAGE_TYPE=memory
# DOC_DATABASE_URL=sqlite+aiosqlite:///./doc_assistant.db
# VL_STORAGE_TYPE=memory
# VL_DATABASE_URL=sqlite+aiosqlite:///./vl_agent.db

# Session Monitor 配置 (doc_assistant 长期记忆自动保存)
# SESSION_MONITOR_ENABLED=true        # 启用 session 不活跃自动保存到长期记忆
# SESSION_MONITOR_TIMEOUT=300         # 不活跃超时秒数 (默认 300 = 5分钟)
